{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "NodeNext", // Permite manejar mejor archivos .mjs y .cjs
    "moduleResolution": "NodeNext", // Recomendado para Node.js moderno y NestJS 10+
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@pulseia/shared": ["../../packages/shared/src"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noEmit": false,
    "esModuleInterop": true // Crucial para importar paquetes que no son ESM puro
  },
  "include": ["src", "eslint.config.mjs"] // Añade el config de ESLint para que TS lo entienda
}
