{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pulseia/ui": ["../../packages/ui/src"],
      "@pulseia/shared": ["../../packages/shared/src"]
    },
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "app", "src", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
