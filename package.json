{
  "name": "pulseia",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:docker": "docker compose -f infra/compose/docker-compose.dev.yml up --build",
    "db:migrate": "node scripts/db/migrate.js",
    "db:seed": "node scripts/db/seed.js",
    "db:reset": "node scripts/db/reset.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@pulseia/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.3",
    "lint-staged": "^15.2.9",
    "pg": "^8.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.10",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  }
}
